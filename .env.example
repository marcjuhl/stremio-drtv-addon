# Server Configuration
PORT=7000

# DR TV (Danmarks Radio) Account Credentials (Optional - for restricted streams and personalized access)
DR_EMAIL=
DR_PASSWORD=

# Session & Token Settings
# Path to persist the cached session token between addon restarts
SESSION_STORAGE_PATH=./.session_cache.json

# Fallback Geoblocking Proxy (Optional: specify an HTTP/HTTPS proxy located in Denmark if hosted outside DK)
# HTTP_PROXY=http://user:pass@dk-proxy.example.com:8080
